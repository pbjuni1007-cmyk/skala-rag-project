# KV Cache 다관점 평가 에이전트 환경변수 템플릿
# 사용 준비: 이 파일을 .env.local로 복사한 뒤 빈 필수 값을 입력합니다.
# 실제 API 키는 이 예제 파일에 넣지 않고, .env.local은 공유·커밋하지 않습니다.
# .env.local을 자동으로 읽으며, 같은 이름의 셸 환경변수가 있으면 셸 값이 우선합니다.
# 경로는 프로젝트 루트 기준입니다. 공백이 있는 값은 큰따옴표로 감쌉니다.

# -----------------------------------------------------------------------------
# 1. GPT API — 유료 실행 전 필수 입력
# 기술 조사·성숙도 / 시장 / 이해관계자 / 도메인 / 종합·보고서가 함께 사용합니다.
# 역할별 API 키나 별도 평가용 LLM은 필요하지 않습니다.
# OPENAI_MODEL에는 계정에서 사용할 수 있는 정확한 모델 ID를 입력합니다.
# 가능한 경우 고정 버전을 사용하고, 아래 단가도 동일 모델 기준으로 입력합니다.
# 공식 모델·가격 확인: https://platform.openai.com/docs/models
#                     https://openai.com/api/pricing/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=max
# balanced: 질의·수정 low, 조사·관점 medium, 종합 max. fixed: 위 값을 모든 역할에 적용.
LLM_REASONING_PROFILE=balanced

# 소켓 응답 대기 제한(초), 명시적 HTTP 429에 대한 추가 재시도 횟수입니다.
# SDK와 앱의 재시도를 중복 적용하지 않고, 총 추가 재시도를 2회로 제한합니다.
# timeout·네트워크 오류·5xx는 중복 과금 위험 때문에 재전송하지 않고 예약을 유지합니다.
OPENAI_TIMEOUT_SECONDS=900
OPENAI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# 2. 호출·병렬 실행 제한 — 공통 GPT 모델 기준
# 토큰 한도에는 프롬프트·출처·대화·도구 입력을 포함합니다.
# 출력 한도는 선택 모델에서 과금되는 추론 토큰도 고려해 적용해야 합니다.
# 모델의 실제 지원 한도를 넘으면 실행 전에 오류로 처리하도록 구현합니다.
LLM_MAX_INPUT_TOKENS=24000
LLM_MAX_OUTPUT_TOKENS=64000

# 병렬 State·예산 검증 후 세 관점을 동시에 실행합니다. 직렬 검증은 1로 설정합니다.
# API 호출 횟수에는 재시도와 응답 수정 요청도 포함합니다.
RAG_MAX_CONCURRENCY=3
RAG_MAX_API_CALLS_PER_RUN=40

# -----------------------------------------------------------------------------
# 3. 팀 전체 GPT API 예산 — 유료 실행 전 단가·환율 필수 입력
# 단가 단위: 100만 토큰당 미국 달러(USD). 0을 임의로 입력하지 않습니다.
# 환율 단위: 1 USD당 원화(KRW). 확인일은 YYYY-MM-DD 형식입니다.
# 예산 예약은 캐시 할인을 제외하고 더 높은 캐시 쓰기 단가($0.25)를 적용합니다.
# 별도 과금 도구·검색 API는 이 설계의 기본 실행에 포함하지 않습니다.
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.20
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=1.20
USD_TO_KRW=
PRICING_CHECKED_AT=2026-09-21

# 프로젝트 전체 한도 5만 원, 내부 집행 상한 4만 5천 원입니다.
# 1.10은 환율 변동·세금·수수료에 대비한 보수적 추정 배수입니다.
# 실제 수수료율을 뜻하지 않으며, 결제 조건을 확인한 뒤 조정합니다.
# 예상 KRW = 토큰별 USD 비용 합계 × USD_TO_KRW × BUDGET_COST_MULTIPLIER
PROJECT_BUDGET_KRW=50000
PROJECT_SPEND_LIMIT_KRW=45000
BUDGET_COST_MULTIPLIER=1.10

# 실행마다 초기화하지 않는 프로젝트 전체 누적 장부입니다.
# 유료 호출은 팀 담당자 1명·단일 환경에서 수행하며, 모든 실행이 이 장부를 씁니다.
# 청구 여부가 불분명한 시간 초과는 예약 비용을 유지하고 확인 후 정산합니다.
BUDGET_LEDGER_PATH=.local/usage.json

# -----------------------------------------------------------------------------
# 4. 오픈소스 임베딩 — GPT API와 별개로 로컬 CPU에서 실행
# 공개 모델이므로 기본 설계에 Hugging Face API 키나 유료 임베딩 키는 없습니다.
# REVISION은 선택 입력: 비어 있으면 코드의 모델별 고정 revision을 사용합니다.
# 같은 모델의 기존 인덱스 revision을 재사용하며 실제 값은 실행 manifest에 기록합니다.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
HF_HOME=.cache/huggingface

# -----------------------------------------------------------------------------
# 5. 자료·중간 결과·보고서 위치
# 자료 목록, 기술 선정, 청크 크기, 검색 질문, 출처 허용 목록 등은 저장소 설정으로
# 관리합니다. 지정 문서 풀·총 200페이지 제한은 환경변수로 해제하지 않습니다.
# 기본 외부 조사는 등록된 공식 URL만 사용하므로 검색 서비스 API 키는 없습니다.
RAG_DATA_DIR=data
RAG_INDEX_DIR=.cache/rag-index
RAG_WEB_SNAPSHOT_DIR=data/web_snapshots
RAG_OUTPUT_DIR=outputs

# 공개 자료 HTTP 요청의 시간 제한(초)입니다. GPT API 시간 제한과 구분합니다.
SOURCE_HTTP_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# 6. Markdown·PDF 제출 정보 — 실행 완료 시 함께 생성합니다.
# 최종 제출용 파일명 생성 전 입력: 캠퍼스(광주/울산/판교), 반(예: 1반),
# 팀원 4명의 실제 이름을 +로 연결한 값(예: 이름1+이름2+이름3+이름4).
# 실제 기여 역할은 README Contributors에 별도로 작성합니다.
REPORT_CAMPUS=
REPORT_CLASS=
REPORT_CONTRIBUTORS=

# -----------------------------------------------------------------------------
# 7. 로깅
# API 키·인증 헤더는 로그와 실행 결과에 기록하지 않습니다.
# 근거·주장·실행 상태는 로컬 산출물로 보존합니다.
LOG_LEVEL=INFO

# 선택 사항: 실행 시간·모델 사용량만 LangSmith로 전송합니다. 원문은 보내지 않습니다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skala-rag-project
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
